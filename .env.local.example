# ===== MT Makers — variáveis de ambiente =====

# ID da planilha do Google Sheets
GOOGLE_SHEETS_ID=16_o2hNUeyUZgrPhbWH4iGeU-AAGfygBjgjRgEJzUa3Y

# JSON da Service Account (em uma única linha). Compartilhe a planilha
# com o e-mail "client_email" da service account (permissão de Editor).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}

# Chave da API da Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# (opcional) modelo do Claude — padrão: claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5

# Nome do app
NEXT_PUBLIC_APP_NAME=MT Makers

# ===== Autenticação (Clerk) — https://dashboard.clerk.com → API Keys =====
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Cadastro público desativado: sign-up aponta para o login.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
